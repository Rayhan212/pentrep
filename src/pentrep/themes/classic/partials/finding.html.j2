{% from "partials/macros.html.j2" import badge %}
<article class="finding" id="{{ finding.anchor }}">
<h3>{{ finding.id }}: {{ finding.title }}</h3>
<dl class="finding-meta">
<dt>Severity</dt><dd>{{ badge(finding.severity) }}</dd>
{% if finding.score is not none %}
<dt>CVSS 3.1 score</dt><dd>{{ finding.score_text }} (Impact {{ finding.impact_score }}, Exploitability {{ finding.exploitability_score }})</dd>
<dt>Vector</dt><dd><code>{{ finding.vector }}</code></dd>
{% else %}
<dt>CVSS 3.1 score</dt><dd>N/A (informational)</dd>
{% endif %}
<dt>Status</dt><dd>{{ finding.status_label }}</dd>
{% if finding.cwe %}
<dt>CWE</dt><dd>{% for number, url in finding.cwe %}<a href="{{ url }}">CWE-{{ number }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
{% endif %}
</dl>
<h4>Affected assets</h4>
<ul>
{% for asset in finding.affected_assets %}
<li>{{ asset }}</li>
{% endfor %}
</ul>
<h4>Description</h4>
{{ finding.description | markdown }}
<h4>Impact</h4>
{{ finding.impact | markdown }}
<h4>Steps to reproduce</h4>
<ol>
{% for step in finding.steps_to_reproduce %}
<li>{{ step | markdown_inline }}</li>
{% endfor %}
</ol>
{% if finding.evidence %}
<h4>Evidence</h4>
{% for item in finding.evidence %}
<figure class="evidence">
<figcaption>Evidence {{ item.number }}: {{ item.caption }}</figcaption>
{% if item.type == "image" %}
<img src="{{ image_src(item.image_path, item.mime, item.asset_name) }}" alt="{{ item.caption }}">
{% else %}
{{ item.content | highlight(item.language) }}
{% endif %}
</figure>
{% endfor %}
{% endif %}
<h4>Remediation</h4>
{{ finding.remediation | markdown }}
{% if finding.references %}
<h4>References</h4>
<ul>
{% for url in finding.references %}
<li><a href="{{ url }}">{{ url }}</a></li>
{% endfor %}
</ul>
{% endif %}
</article>
